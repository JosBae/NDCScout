# Copy to .env and fill in. .env is gitignored. Never commit a real key.
META_API_KEY=
# Confirmed by third-party provider docs; check against dev.meta.ai/docs if calls fail
META_API_BASE=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# optional: minimal | low | medium | high | xhigh
META_REASONING_EFFORT=
# Local spend guards (Meta has no hard cap)
NDC_SCOUT_MAX_RUN_USD=0.50
NDC_SCOUT_MONTHLY_CAP_USD=100
# Point at real data after `ndc-scout import ...`
# NDC_SCOUT_DATA_DIR=./real_data
